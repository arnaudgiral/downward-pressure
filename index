<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Viol String Pressure Calculator</title>
</head>
<body>
    <div id="root"></div>
    
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone@7/babel.min.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;600&family=IBM+Plex+Mono:wght@400;500&family=Crimson+Text:wght@400;600&display=swap');
        
        :root {
            --parchment: #f8f6f1;
            --ink: #2a2622;
            --sepia: #8b7355;
            --blue-ink: #1a3a52;
            --accent-gold: #c9a961;
            --border: #d4cec4;
            --shadow: rgba(42, 38, 34, 0.08);
        }
        
        body {
            font-family: 'Crimson Text', serif;
            background: linear-gradient(135deg, #f8f6f1 0%, #ede9e0 100%);
            color: var(--ink);
            min-height: 100vh;
            padding: 2rem 1rem;
            line-height: 1.6;
        }
        
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(42, 38, 34, 0.02) 2px, rgba(42, 38, 34, 0.02) 4px);
            pointer-events: none;
            z-index: 1;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }
        
        header {
            text-align: center;
            margin-bottom: 3rem;
            padding-bottom: 2rem;
            border-bottom: 2px solid var(--accent-gold);
        }
        
        h1 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 3rem;
            font-weight: 300;
            color: var(--blue-ink);
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
        }
        
        .subtitle {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.875rem;
            color: var(--sepia);
            text-transform: uppercase;
            letter-spacing: 0.15em;
        }
        
        .card {
            background: white;
            border: 1px solid var(--border);
            border-radius: 2px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 4px 12px var(--shadow);
            position: relative;
        }
        
        .card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--accent-gold), transparent);
        }
        
        h2 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--blue-ink);
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        
        h2::before {
            content: '◆';
            color: var(--accent-gold);
            font-size: 0.75rem;
        }
        
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.75rem;
            color: var(--sepia);
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        
        input, select {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 1rem;
            padding: 0.75rem;
            border: 1px solid var(--border);
            border-radius: 2px;
            background: var(--parchment);
            color: var(--ink);
            transition: all 0.2s;
        }
        
        input:focus, select:focus {
            outline: none;
            border-color: var(--accent-gold);
            box-shadow: 0 0 0 3px rgba(201, 169, 97, 0.1);
        }
        
        .string-tensions {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }
        
        .string-input {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
        
        .string-label {
            font-size: 0.7rem;
            color: var(--blue-ink);
            font-weight: 600;
        }
        
        button {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.125rem;
            font-weight: 600;
            padding: 1rem 2rem;
            border: 2px solid var(--blue-ink);
            background: var(--blue-ink);
            color: white;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            border-radius: 2px;
        }
        
        button:hover {
            background: transparent;
            color: var(--blue-ink);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px var(--shadow);
        }
        
        .button-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        
        .btn-secondary {
            background: transparent;
            color: var(--sepia);
            border-color: var(--sepia);
            font-size: 0.875rem;
            padding: 0.75rem 1.5rem;
        }
        
        .btn-secondary:hover {
            background: var(--sepia);
            color: white;
        }
        
        table {
            width: 100%;
            border-collapse: collapse;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.875rem;
            margin-top: 1rem;
        }
        
        thead {
            background: var(--blue-ink);
            color: white;
        }
        
        th {
            padding: 0.75rem;
            text-align: left;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-size: 0.7rem;
        }
        
        td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border);
        }
        
        tbody tr:hover {
            background: rgba(201, 169, 97, 0.05);
        }
        
        tfoot {
            background: var(--parchment);
            font-weight: 600;
        }
        
        tfoot td {
            border-top: 2px solid var(--blue-ink);
            padding: 1rem 0.75rem;
        }
        
        .result-value {
            color: var(--blue-ink);
            font-weight: 500;
        }
        
        .visualization {
            margin-top: 2rem;
            padding: 2rem;
            background: var(--parchment);
            border: 1px solid var(--border);
            border-radius: 2px;
        }
        
        svg {
            width: 100%;
            height: auto;
        }
        
        .no-results {
            text-align: center;
            padding: 3rem;
            color: var(--sepia);
            font-style: italic;
        }
        
        @media (max-width: 768px) {
            h1 { font-size: 2rem; }
            .form-grid { grid-template-columns: 1fr; }
            .string-tensions { grid-template-columns: repeat(auto-fill, minmax(80px, 1fr)); }
            table { font-size: 0.75rem; }
            th, td { padding: 0.5rem; }
        }
        
        .info-text {
            font-size: 0.875rem;
            color: var(--sepia);
            font-style: italic;
            margin-top: 0.5rem;
        }
        
        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }
        
        .summary-card {
            background: var(--parchment);
            border: 1px solid var(--border);
            padding: 1.5rem;
            border-radius: 2px;
            text-align: center;
        }
        
        .summary-label {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 0.7rem;
            color: var(--sepia);
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }
        
        .summary-value {
            font-family: 'Cormorant Garamond', serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--blue-ink);
        }
        
        .summary-unit {
            font-size: 1rem;
            color: var(--sepia);
            margin-left: 0.25rem;
        }
    </style>
    <script type="text/babel">
        const { useState, useEffect } = React;

        function BridgeVisualization({ results }) {
            const { strings, config } = results;
            const R = parseFloat(config.bridgeRadius);
            const W = parseFloat(config.bridgeWidth);
            
            const svgWidth = 800;
            const svgHeight = 400;
            const margin = 50;
            const plotWidth = svgWidth - 2 * margin;
            const plotHeight = svgHeight - 2 * margin;

            const xScale = (x) => margin + (x + W / 2) * (plotWidth / W);
            const maxDrop = Math.max(...strings.map(s => s.heightDrop));
            const yScale = (y) => svgHeight - margin - (y * plotHeight / (maxDrop * 1.2));

            const points = [];
            for (let x = -W / 2; x <= W / 2; x += 0.5) {
                const drop = R - Math.sqrt(R * R - x * x);
                points.push(`${xScale(x)},${yScale(drop)}`);
            }
            const bridgePath = `M ${points.join(' L ')}`;

            return (
                <div className="visualization">
                    <svg viewBox={`0 0 ${svgWidth} ${svgHeight}`}>
                        <g stroke="#d4cec4" strokeWidth="1" opacity="0.3">
                            {[0, 0.2, 0.4, 0.6, 0.8, 1].map(frac => (
                                <line
                                    key={`grid-h-${frac}`}
                                    x1={margin}
                                    y1={margin + frac * plotHeight}
                                    x2={svgWidth - margin}
                                    y2={margin + frac * plotHeight}
                                />
                            ))}
                        </g>
                        <path d={bridgePath} fill="none" stroke="#1a3a52" strokeWidth="3" strokeLinecap="round" />
                        {strings.map((s, i) => (
                            <g key={i}>
                                <circle cx={xScale(s.position)} cy={yScale(s.heightDrop)} r="6" fill="#c9a961" stroke="#1a3a52" strokeWidth="2" />
                                <text x={xScale(s.position)} y={yScale(s.heightDrop) - 15} textAnchor="middle" fontSize="12" fontFamily="IBM Plex Mono, monospace" fill="#2a2622">{s.stringNum}</text>
                                <line x1={xScale(s.position)} y1={yScale(s.heightDrop)} x2={xScale(s.position)} y2={yScale(s.heightDrop) - (s.pressure * 20)} stroke="#8b7355" strokeWidth="2" strokeDasharray="3,3" opacity="0.6" />
                            </g>
                        ))}
                        <line x1={margin} y1={svgHeight - margin} x2={svgWidth - margin} y2={svgHeight - margin} stroke="#2a2622" strokeWidth="2" />
                        <line x1={margin} y1={margin} x2={margin} y2={svgHeight - margin} stroke="#2a2622" strokeWidth="2" />
                        <text x={svgWidth / 2} y={svgHeight - 10} textAnchor="middle" fontSize="14" fontFamily="IBM Plex Mono, monospace" fill="#8b7355">Position on Bridge (mm)</text>
                        <text x={20} y={svgHeight / 2} textAnchor="middle" fontSize="14" fontFamily="IBM Plex Mono, monospace" fill="#8b7355" transform={`rotate(-90, 20, ${svgHeight / 2})`}>Height Drop (mm)</text>
                        <text x={svgWidth / 2} y={25} textAnchor="middle" fontSize="16" fontFamily="Cormorant Garamond, serif" fontWeight="600" fill="#1a3a52">Bridge Curvature Profile with String Positions</text>
                        <g transform={`translate(${svgWidth - 180}, 50)`}>
                            <text x="0" y="0" fontSize="12" fontFamily="IBM Plex Mono, monospace" fill="#8b7355">Bridge Radius: {R} mm</text>
                            <text x="0" y="20" fontSize="12" fontFamily="IBM Plex Mono, monospace" fill="#8b7355">Bridge Width: {W} mm</text>
                            <circle cx="10" cy="45" r="6" fill="#c9a961" stroke="#1a3a52" strokeWidth="2"/>
                            <text x="25" y="50" fontSize="11" fontFamily="IBM Plex Mono, monospace" fill="#2a2622">String position</text>
                        </g>
                    </svg>
                </div>
            );
        }

        function ViolPressureCalculator() {
            const [config, setConfig] = useState({
                numStrings: 6,
                instrumentType: '6-string bass viol',
                lv: '', lc: '', ds: '', dc: '', hv: '', hc: '',
                bridgeRadius: '', bridgeWidth: ''
            });
            const [tensions, setTensions] = useState(Array(6).fill(''));
            const [results, setResults] = useState(null);
            const [savedConfigs, setSavedConfigs] = useState([]);

            useEffect(() => {
                try {
                    const saved = localStorage.getItem('violConfigs');
                    if (saved) setSavedConfigs(JSON.parse(saved));
                } catch (e) { console.error('Load error:', e); }
            }, []);

            useEffect(() => {
                setTensions(Array(parseInt(config.numStrings) || 6).fill(''));
            }, [config.numStrings]);

            const handleConfigChange = (field, value) => {
                setConfig(prev => ({ ...prev, [field]: value }));
            };

            const handleTensionChange = (index, value) => {
                const newTensions = [...tensions];
                newTensions[index] = value;
                setTensions(newTensions);
            };

            const calculatePressure = () => {
                try {
                    const { numStrings, lv, lc, ds, dc, hv, hc, bridgeRadius, bridgeWidth } = config;
                    const n = parseInt(numStrings);
                    const Lv = parseFloat(lv), Lc = parseFloat(lc);
                    const dsVal = parseFloat(ds), dcVal = parseFloat(dc);
                    const Hv = parseFloat(hv), Hc = parseFloat(hc);
                    const R = parseFloat(bridgeRadius), W = parseFloat(bridgeWidth);

                    if (!n || !Lv || !Lc || isNaN(dsVal) || isNaN(dcVal) || !Hv || !Hc || !R || !W) {
                        alert('Please fill in all configuration fields');
                        return;
                    }

                    const stringResults = [];
                    let totalPressure = 0, totalTension = 0;

                    for (let i = 0; i < n; i++) {
                        const T = parseFloat(tensions[i]);
                        if (!T) {
                            alert(`Please enter tension for string ${i + 1}`);
                            return;
                        }
                        totalTension += T;

                        const x = -W / 2 + (i * W / (n - 1));
                        const heightDrop = R - Math.sqrt(R * R - x * x);
                        const HcEff = Hc - heightDrop;
                        const heightAtBridge = Hv + HcEff - dsVal;
                        const heightAtTailpiece = Hv + HcEff - dcVal;
                        const a = Math.sqrt(Lv * Lv - heightAtBridge * heightAtBridge);
                        const b = Math.sqrt(Lc * Lc - heightAtTailpiece * heightAtTailpiece);
                        const angleRad1 = Math.acos(heightAtBridge / Lv);
                        const angleRad2 = Math.acos(heightAtTailpiece / Lc);
                        const breakAngle = (angleRad1 + angleRad2) * 180 / Math.PI;
                        const P = T * (b * heightAtBridge + a * heightAtTailpiece) / (b * Lv);
                        totalPressure += P;

                        stringResults.push({
                            stringNum: i + 1, position: x, heightDrop, effectiveBridgeHeight: HcEff,
                            breakAngle, tension: T, pressure: P
                        });
                    }

                    setResults({
                        strings: stringResults, totalPressure, totalTension,
                        avgPressure: totalPressure / n, config
                    });
                } catch (e) {
                    console.error('Calculation error:', e);
                    alert('Error in calculation: ' + e.message);
                }
            };

            const saveConfig = () => {
                const name = prompt('Enter a name for this configuration:');
                if (!name) return;
                const newConfig = { name, timestamp: new Date().toISOString(), config, tensions };
                const updated = [...savedConfigs, newConfig];
                setSavedConfigs(updated);
                localStorage.setItem('violConfigs', JSON.stringify(updated));
                alert('Configuration saved!');
            };

            const loadConfig = () => {
                if (savedConfigs.length === 0) {
                    alert('No saved configurations');
                    return;
                }
                const configList = savedConfigs.map((c, i) => 
                    `${i + 1}. ${c.name} (${new Date(c.timestamp).toLocaleDateString()})`
                ).join('\n');
                const choice = prompt(`Select configuration:\n${configList}\n\nEnter number:`);
                const index = parseInt(choice) - 1;
                if (index >= 0 && index < savedConfigs.length) {
                    const loaded = savedConfigs[index];
                    setConfig(loaded.config);
                    setTensions(loaded.tensions);
                    alert('Configuration loaded!');
                }
            };

            const deleteConfigs = () => {
                if (confirm('Delete all saved configurations?')) {
                    setSavedConfigs([]);
                    localStorage.removeItem('violConfigs');
                    alert('All configurations deleted');
                }
            };

            return (
                <div className="container">
                    <header>
                        <h1>Viol String Pressure Calculator</h1>
                        <div className="subtitle">Precision Calculations for Viola da Gamba</div>
                    </header>

                    <div className="card">
                        <h2>Instrument Configuration</h2>
                        <div className="form-grid">
                            <div className="form-group">
                                <label>Number of Strings</label>
                                <select value={config.numStrings} onChange={(e) => handleConfigChange('numStrings', e.target.value)}>
                                    <option value="4">4 Strings</option>
                                    <option value="5">5 Strings</option>
                                    <option value="6">6 Strings</option>
                                    <option value="7">7 Strings</option>
                                </select>
                            </div>
                            <div className="form-group">
                                <label>Instrument Type</label>
                                <select value={config.instrumentType} onChange={(e) => handleConfigChange('instrumentType', e.target.value)}>
                                    <option value="6-string bass viol">6-String Bass Viol</option>
                                    <option value="7-string bass viol">7-String Bass Viol</option>
                                    <option value="treble viol">Treble Viol</option>
                                    <option value="tenor viol">Tenor Viol</option>
                                    <option value="custom">Custom</option>
                                </select>
                            </div>
                            <div className="form-group">
                                <label>Vibrating Length (Lv) mm</label>
                                <input type="number" step="0.1" value={config.lv} onChange={(e) => handleConfigChange('lv', e.target.value)} placeholder="e.g. 670" />
                            </div>
                            <div className="form-group">
                                <label>Tailpiece Length (Lc) mm</label>
                                <input type="number" step="0.1" value={config.lc} onChange={(e) => handleConfigChange('lc', e.target.value)} placeholder="e.g. 284" />
                                <span className="info-text">From anchor point + dead string</span>
                            </div>
                            <div className="form-group">
                                <label>Nut Height (ds) mm</label>
                                <input type="number" step="0.1" value={config.ds} onChange={(e) => handleConfigChange('ds', e.target.value)} placeholder="e.g. -3" />
                                <span className="info-text">Relative to reference plane</span>
                            </div>
                            <div className="form-group">
                                <label>Tailpiece Height (dc) mm</label>
                                <input type="number" step="0.1" value={config.dc} onChange={(e) => handleConfigChange('dc', e.target.value)} placeholder="e.g. 15" />
                                <span className="info-text">At anchor point</span>
                            </div>
                            <div className="form-group">
                                <label>Arch Height (Hv) mm</label>
                                <input type="number" step="0.1" value={config.hv} onChange={(e) => handleConfigChange('hv', e.target.value)} placeholder="e.g. 19" />
                                <span className="info-text">At bridge level</span>
                            </div>
                            <div className="form-group">
                                <label>Bridge Height (Hc) mm</label>
                                <input type="number" step="0.1" value={config.hc} onChange={(e) => handleConfigChange('hc', e.target.value)} placeholder="e.g. 75" />
                                <span className="info-text">At center</span>
                            </div>
                            <div className="form-group">
                                <label>Bridge Radius (R) mm</label>
                                <input type="number" step="0.1" value={config.bridgeRadius} onChange={(e) => handleConfigChange('bridgeRadius', e.target.value)} placeholder="e.g. 42" />
                            </div>
                            <div className="form-group">
                                <label>Bridge Width (W) mm</label>
                                <input type="number" step="0.1" value={config.bridgeWidth} onChange={(e) => handleConfigChange('bridgeWidth', e.target.value)} placeholder="e.g. 60" />
                                <span className="info-text">Total width between outer strings</span>
                            </div>
                        </div>

                        <h2>String Tensions</h2>
                        <div className="string-tensions">
                            {tensions.map((t, i) => (
                                <div key={i} className="string-input">
                                    <label className="string-label">String {i + 1}</label>
                                    <input type="number" step="0.1" value={t} onChange={(e) => handleTensionChange(i, e.target.value)} placeholder="kg" />
                                </div>
                            ))}
                        </div>

                        <div className="button-group" style={{ marginTop: '2rem' }}>
                            <button onClick={calculatePressure}>Calculate Pressure</button>
                            <button className="btn-secondary" onClick={saveConfig}>Save Config</button>
                            <button className="btn-secondary" onClick={loadConfig}>Load Config</button>
                            <button className="btn-secondary" onClick={deleteConfigs}>Clear Saved</button>
                        </div>
                    </div>

                    {results && (
                        <>
                            <div className="card">
                                <h2>Summary</h2>
                                <div className="summary-grid">
                                    <div className="summary-card">
                                        <div className="summary-label">Total Tension</div>
                                        <div className="summary-value">{results.totalTension.toFixed(2)}<span className="summary-unit">kg</span></div>
                                    </div>
                                    <div className="summary-card">
                                        <div className="summary-label">Total Pressure</div>
                                        <div className="summary-value">{results.totalPressure.toFixed(2)}<span className="summary-unit">kg</span></div>
                                    </div>
                                    <div className="summary-card">
                                        <div className="summary-label">Average Pressure</div>
                                        <div className="summary-value">{results.avgPressure.toFixed(2)}<span className="summary-unit">kg</span></div>
                                    </div>
                                </div>
                            </div>

                            <div className="card">
                                <h2>Individual String Analysis</h2>
                                <table>
                                    <thead>
                                        <tr>
                                            <th>String</th>
                                            <th>Position (mm)</th>
                                            <th>Height Drop (mm)</th>
                                            <th>Eff. Bridge Height (mm)</th>
                                            <th>Break Angle (°)</th>
                                            <th>Tension (kg)</th>
                                            <th>Pressure (kg)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {results.strings.map((s) => (
                                            <tr key={s.stringNum}>
                                                <td>{s.stringNum}</td>
                                                <td>{s.position.toFixed(2)}</td>
                                                <td>{s.heightDrop.toFixed(3)}</td>
                                                <td>{s.effectiveBridgeHeight.toFixed(2)}</td>
                                                <td>{s.breakAngle.toFixed(2)}</td>
                                                <td>{s.tension.toFixed(2)}</td>
                                                <td className="result-value">{s.pressure.toFixed(3)}</td>
                                            </tr>
                                        ))}
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <td colSpan="5"><strong>TOTAL</strong></td>
                                            <td><strong>{results.totalTension.toFixed(2)}</strong></td>
                                            <td className="result-value"><strong>{results.totalPressure.toFixed(2)}</strong></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <div className="card">
                                <h2>Bridge Profile Visualization</h2>
                                <BridgeVisualization results={results} />
                            </div>
                        </>
                    )}

                    {!results && (
                        <div className="card">
                            <div className="no-results">
                                Enter instrument configuration and string tensions, then click Calculate Pressure to see results.
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<ViolPressureCalculator />);
    </script>
</body>
</html>
